*.jl.cov
*.jl.*.cov
*.jl.mem

*.txt
*.csv
*.json
*.xml
*.data
*.model
*.ods

# Package-bundled JSON resources (rule bundles, schema samples) — not data.
!src/rules/*.json
!examples/*.json

# Tiny checked-in test fixture (the *.csv rule above is for downloaded
# datasets, not this hand-written harness fixture).
!benchmarks/loghub2/toy_structured.csv

# Rust build artefacts
/rust/target/

# uv-managed Python venv
/py/.venv/

# LogHub-2.0 downloads (fetched by benchmarks/loghub2/download.jl)
/benchmarks/loghub2/data/

# CondaPkg bootstrap cache (created by PythonCall on first use)
/.CondaPkg/

# Documenter build output
/docs/build/
/docs/Manifest.toml
